# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values. `.env` is git-ignored;
# this example is versioned so anyone can point the app at their own
# backend.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Base URL of the ClickTuCasa Spring Boot microservice. No trailing slash.
# The app appends /api/v1/raffles to it.
VITE_API_URL=http://localhost:8080
